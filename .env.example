SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_KEY=tu-anon-key
SUPABASE_SERVICE_ROLE_KEY=tu-service-role-key
SUPABASE_AUTH_EMAIL_DOMAIN=aifitnesscoach.app
GEMINI_API_KEY=tu-clave-de-gemini-opcional

# Proveedores de IA alternativos con failover automatico.
# Orden de intento: gemini -> openrouter -> mistral -> groq
#
# Accesibilidad verificada desde Venezuela el 2026-09-25:
#   Gemini      -> accesible, buena calidad, cuota gratuita corta.
#   OpenRouter  -> ACCESIBLE, ~17 modelos :free. Recomendado como respaldo.
#   Mistral     -> accesible, modo gratuito con topes.
#   Groq        -> devuelve HTTP 403 desde esta red (bloqueo por pais).
#   Cohere      -> accesible. DeepSeek -> accesible (de pago, muy barato).
#
# Todos son gratuitos salvo DeepSeek, y ninguno exige tarjeta.
# OPENROUTER_API_KEY=sk-or-v1-...
# MISTRAL_API_KEY=...

# Modelos opcionales por proveedor (si no, se usa el predeterminado).
# Los modelos :free de OpenRouter rotan; revisa https://openrouter.ai/models
# OpenRouter admite lista separateda por comas y los prueba en orden:
# OPENROUTER_MODELS=qwen/qwen3.8-27b:free,google/gemma-4-26b-a4b-it:free
# MISTRAL_MODEL=mistral-small-latest
# GROQ_MODEL=openai/gpt-oss-120b
# GEMINI_MODEL=gemini-2.5-flash

DATABASE_URL=postgresql://postgres:password@db.xxxxxxxx.supabase.co:5432/postgres
