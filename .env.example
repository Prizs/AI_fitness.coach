SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_KEY=tu-anon-key
SUPABASE_SERVICE_ROLE_KEY=tu-service-role-key
SUPABASE_AUTH_EMAIL_DOMAIN=aifitnesscoach.app
GEMINI_API_KEY=tu-clave-de-gemini-opcional

# Proveedores de IA alternativos con failover automatico.
# Todos ofrecen tier gratuito SIN tarjeta y funcionan desde Venezuela.
# Solo se usan los que tengan clave; el orden de intento es:
# gemini -> groq -> openrouter -> mistral
# GROQ_API_KEY=tu-clave-groq            (console.groq.com, 30 RPM, 1000 RPD)
# OPENROUTER_API_KEY=tu-clave-openrouter (openrouter.ai, modelos :free)
# MISTRAL_API_KEY=tu-clave-mistral      (mistral.ai, modo gratuito)

# Modelos opcionales por proveedor (si no, se usa el predeterminado).
# GROQ_MODEL=openai/gpt-oss-120b
# OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free
# MISTRAL_MODEL=mistral-small-latest
# GEMINI_MODEL=gemini-2.5-flash

DATABASE_URL=postgresql://postgres:password@db.xxxxxxxx.supabase.co:5432/postgres
